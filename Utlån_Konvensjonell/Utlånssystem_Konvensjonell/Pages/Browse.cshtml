@page
@model BrowseModel
@{
    ViewData["Title"] = "Browse Games";
}
<h1>@ViewData["Title"]</h1>

<p>Look at what boardgames you can borrow from us.</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}



@if( Model.Games.Any()){
    @foreach (var game in Model.Games)
    {
        
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@game.Name</h5>
                <p>Amount avalalalable: @game.Quantity</p>
                <p class="card-text">Description: @game.Description</p>
                @if (game.ImagePath != null)
                {
                    <img src="@game.ImagePath" class="img-fluid" />
                }else{
                    <img src="image/Default.jpg" class="img-fluid" />
                }
                <form method="post" asp-page-handler="Rent" asp-route-id="@game.Id" class="d-inline">
                <button class="btn btn-primary" type="submit">Rent</button>
                </form>

                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <form method="post" asp-page-handler="Edit" asp-route-id="@game.Id" class="d-inline">
                              <button class="btn btn-primary" type="submit">Edit</button>
                            </form>

                            <form method="post" asp-page-handler="Delete" asp-route-id="@game.Id" class="d-inline">
                              <button class="btn btn-primary" type="submit">Delete</button>
                            </form>
                        }
              
                
            </div>
        </div>
    </div>
    }}
    else{
        <p>Sowwy, empty</p>
        }

