@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <div class="text-center">
        <h1 class="display-4">Welcome, create a user to rent our games!</h1>
    </div>
}
else if (!Model.isauthorized)
{
    <div class="text-center">
        <h1 class="display-4">You have not yet been authorized by an admin!</h1>
    </div>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Welcome back!</h1>
    </div>
}

