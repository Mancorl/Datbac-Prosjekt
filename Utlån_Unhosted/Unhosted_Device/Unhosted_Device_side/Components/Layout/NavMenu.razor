@using Unhosted_Device_side.Data
@using Unhosted_Device_side.Data.Tables
@using Unhosted_Device_side.Models

@inject AppDatabase Database

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Unhosted_Device_side</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>
         <div class="nav-item px-3">
            <NavLink class="nav-link" href="browse">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Browse Games
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
          <div class="nav-item px-3">
            <NavLink class="nav-link" href="loans">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Loaned Games
            </NavLink>
        </div>
        @if (IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="addgame">
                    <span class="bi bi-plus-square-fill-nav-menu"></span> Add Game
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="authorize">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Authorize User
                </NavLink>
            </div>
        }
    </nav>
</div>


@code {
    private UserEntity? _user;

    protected override async Task OnInitializedAsync()
    {
        var users = await Database.GetUsersAsync();
        _user = users.FirstOrDefault();
    }

    private bool IsAdmin => _user?.Permission == Permission.Admin;
}