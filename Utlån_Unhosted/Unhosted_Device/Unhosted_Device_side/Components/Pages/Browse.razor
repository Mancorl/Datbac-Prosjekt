@page "/browse"
@using Unhosted_Device_side.Data
@using Unhosted_Device_side.Data.Tables
@using Unhosted_Device_side.Services;
@inject AppDatabase Database
@inject RentService RentService
@inject GameService GameService

<div class="container py-3">
    <p>Look at what boardgames you can borrow from us.</p>

                    <div class="container py-3">

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-warning">
            @_message
        </div>
    }

    </div>
    
    @if (_games is not null && _games.Any())
    {
        <div class="row">
            @foreach (var game in _games)
            {
                <div class="col-12 col-md-6 col-lg-3 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@game.Name</h5>
                            <p>Name: @game.Name Amount available: @game.Quantity</p>
                            <p class="card-text">Description: @game.Description</p>

                            @if (!string.IsNullOrWhiteSpace(game.ImagePath))
                            {
                                <img src="@game.ImagePath" class="img-fluid mb-3" />
                            }
                            else
                            {
                                <img src="images/Default.jpg" class="img-fluid mb-3" />
                            }

                            <button class="btn btn-primary me-2"
                                    @onclick="() => RentGame(game.Id)">
                                Rent
                            </button>

                          
                            

                            @if (_isAdmin)
                            {
                             <p>Hello Dadmin</p>
                               
                            }

                            <button class="btn btn-warning mb-3" @onclick="RefillGames">
                                Refill all games
                            </button>
                        </div>
                    </div>
                </div>
  

            }
          
        </div>
    }
    else
    {
        <p>Sowwy, empty</p>
    }
</div>

@code {
    private List<GameEntity>? _games;

    // Bare sette brukeren som admin når eg debugge shit
    private bool _isAdmin = true;

    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadGamesAsync();
    }
    

    private async Task LoadGamesAsync()
    {
        await GameService.GetGamesFromApiAsync();
        _games = await GameService.GetLocalGamesAsync();
    }


private async Task RentGame(Guid gameId)
{
    var users = await Database.GetUsersAsync();
    var user = users.FirstOrDefault();

    if (user is null)
    {
        _message = "No user found.";
        return;
    }

    _message = await RentService.RentGameAsync(user.Id, gameId);
    _games = await Database.GetGamesAsync();
}

private async Task RefillGames()
{
    if (_games is null)
        return;

    foreach (var game in _games)
    {
        game.Quantity = game.TotalQuantity;
        await Database.SaveGameAsync(game);
    }

    _message = "All games refilled!";
    _games = await Database.GetGamesAsync();
}

}