@page "/loans"
@using Unhosted_Device_side.Data
@using Unhosted_Device_side.Data.Tables
@using Unhosted_Device_side.Services
@inject AppDatabase Database
@inject RentService RentService
@inject HttpClient Http



<div class="container py-3">
    <p>You are currently loaning:</p>

    @if (!_loanedGames.Any())
    {
        <p>You are not renting any games.</p>
    }
    else
    {
        <div class="row">
            @foreach (var game in _loanedGames)
            {
                <div class="col-12 col-md-6 col-lg-3 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@game.Name</h5>
                            <p>Name: @game.Name</p>
                            <p class="card-text">Description: @game.Description</p>

                            @if (!string.IsNullOrWhiteSpace(game.ImagePath))
                            {
                                <img src="@GetImageUrl(game.ImagePath)" class="img-fluid mb-3" />
                            }
                            else
                            {
                                <img src="images/Default.jpg" class="img-fluid mb-3" />
                            }

                            
                        </div>
                    </div>
                </div>
  

            }
          
        </div>
    }
</div>








@code {
    private List<GameEntity> _loanedGames = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLoansAsync();
    }

    private async Task LoadLoansAsync()
{
    var users = await Database.GetUsersAsync();
    var user = users.FirstOrDefault();

    if (user is null)
    {
        _loanedGames = new List<GameEntity>();
        return;
    }

    // 🔥 NEW: sync from API first
    await RentService.SyncUserRentsAsync(user.Id);

    var rents = await Database.GetRentsAsync();

    var activeRents = rents
        .Where(r => r.UserId == user.Id && r.Active)
        .ToList();

    var games = await Database.GetGamesAsync();

    _loanedGames = games
        .Where(g => activeRents.Any(r => r.GameId == g.Id))
        .ToList();
}

private string GetImageUrl(string? path)
    {
    var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

    if (string.IsNullOrWhiteSpace(path))
        return $"{baseUrl}/images/Default.jpg";

    return $"{baseUrl}/{path.TrimStart('/')}";
    }
}